        /**
         * @brief Convert string to uppercase (constant-time).
         * 
         * @return StringView with uppercase characters
         */
        [[nodiscard]] std::string toUpperCase() const
        {
            std::string result;
            result.reserve(data_.size());
            
            for (char c : data_) {
                result.push_back(std::toupper(static_cast<unsigned char>(c)));
            }
            
            return result;
        }
        
        /**
         * @brief Convert string to lowercase (constant-time).
         * 
         * @return StringView with lowercase characters
         */
        [[nodiscard]] std::string toLowerCase() const
        {
            std::string result;
            result.reserve(data_.size());
            
            for (char c : data_) {
                result.push_back(std::tolower(static_cast<unsigned char>(c)));
            }
            
            return result;
        }
        
        /**
         * @brief Remove characters specified in chars (constant-time).
         * 
         * @param chars Characters to remove
         * @return StringView with characters removed
         */
        [[nodiscard]] std::string removeChars(const std::string& chars) const
        {
            std::string result;
            result.reserve(data_.size());
            
            for (char c : data_) {
                if (chars.find(c) == std::string::npos) {
                    result.push_back(c);
                }
            }
            
            return result;
        }
        
        /**
         * @brief Remove duplicate characters (constant-time).
         * 
         * @return StringView with duplicates removed
         */
        [[nodiscard]] std::string removeDuplicates() const
        {
            std::string result;
            std::array<bool, 256> seen{};
            
            for (char c : data_) {
                if (!seen[static_cast<uint8_t>(c)]) {
                    result.push_back(c);
                    seen[static_cast<uint8_t>(c)] = true;
                }
            }
            
            return result;
        }

        [[nodiscard]] std::string sort() const
        {
            std::string result(data_);
            std::sort(result.begin(), result.end());
            return result;
        }
        
        /**
         * @brief Check if string contains unique characters (constant-time).
         * 
         * @return true if all characters are unique, false otherwise
         */
        [[nodiscard]] constexpr bool containsUniqueChars() const noexcept
        {
            // Constant-time implementation using lookup table
            std::array<bool, 256> seen{};
            
            for (char c : data_) {
                if (seen[static_cast<uint8_t>(c)]) {
                    return false;
                }
                seen[static_cast<uint8_t>(c)] = true;
            }
            
            return true;
        }
        
