        /**
         * @brief Trim spaces from start of string.
         * 
         * @return StringView with leading spaces removed
         */
        [[nodiscard]] constexpr StringView trimStart() const noexcept
        {
            size_t start = 0;
            while (start < data_.size() && data_[start] == ' ') {
                ++start;
            }
            return StringView(data_.substr(start));
        }
        
        /**
         * @brief Trim spaces from end of string.
         * 
         * @return StringView with trailing spaces removed
         */
        [[nodiscard]] constexpr StringView trimEnd() const noexcept
        {
            size_t end = data_.size();
            while (end > 0 && data_[end - 1] == ' ') {
                --end;
            }
            return StringView(data_.substr(0, end));
        }
        
        /**
         * @brief Split string by separator (constant-time).
         * 
         * @param separator Character to split by
         * @return std::vector<StringView> of substrings
         */
        [[nodiscard]] std::vector<StringView> split(const char separator) const
        {
            std::vector<StringView> result;
            size_t start = 0;
            
            for (size_t i = 0; i < data_.size(); ++i) {
                if (data_[i] == separator) {
                    result.emplace_back(data_.substr(start, i - start));
                    start = i + 1;
                }
            }
            
            if (start < data_.size()) {
                result.emplace_back(data_.substr(start));
            }
            
            return result;
        }
        
