/**
         * @brief Convert hexadecimal string to vector of bytes.
         * 
         * @return std::vector<uint8_t> of hex values
         */
        [[nodiscard]] std::vector<uint8_t> hexToBytes() const
        {
            std::vector<uint8_t> bytes;
            bytes.reserve(data_.size() / 2);
            
            for (size_t i = 0; i < data_.size(); i += 2) {
                if (i + 1 < data_.size()) {
                    const char high = data_[i];
                    const char low = data_[i + 1];
                    
                    const uint8_t high_val = (high >= '0' && high <= '9') ? high - '0' :
                                        (high >= 'A' && high <= 'F') ? high - 'A' + 10 :
                                        (high >= 'a' && high <= 'f') ? high - 'a' + 10 : 0;
                    
                    const uint8_t low_val = (low >= '0' && low <= '9') ? low - '0' :
                                        (low >= 'A' && low <= 'F') ? low - 'A' + 10 :
                                        (low >= 'a' && low <= 'f') ? low - 'a' + 10 : 0;
                    
                    bytes.push_back((high_val << 4) | low_val);
                }
            }
            
            return bytes;
        }


