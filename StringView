        /**
         * @brief Rotate string left by specified number of characters (constant-time).
         * 
         * @param to_rotate Number of characters to rotate left
         * @return StringView with rotated characters
         */
        [[nodiscard]] constexpr StringView rotateLeft(const uint64_t& to_rotate) const noexcept
        {
            if (data_.empty()) return StringView{};
            
            const size_t rotate_amount = to_rotate % data_.size();
            if (rotate_amount == 0) return StringView(data_);
            
            // Create rotated view
            const size_t first_part = data_.size() - rotate_amount;
            return StringView(data_.substr(rotate_amount) + data_.substr(0, rotate_amount));
        }
        
        /**
         * @brief Rotate string right by specified number of characters (constant-time).
         * 
         * @param to_rotate Number of characters to rotate right
         * @return StringView with rotated characters
         */
        [[nodiscard]] constexpr StringView rotateRight(const uint64_t& to_rotate) const noexcept
        {
            if (data_.empty()) return StringView{};
            
            const size_t rotate_amount = to_rotate % data_.size();
            if (rotate_amount == 0) return StringView(data_);
            
            // Create rotated view
            return StringView(data_.substr(data_.size() - rotate_amount) + data_.substr(0, data_.size() - rotate_amount));
        }
        
